# Spartan Dashboard settings - copy to .env (gitignored) and fill in.

# --- Sign in with Google (only @adit.com accounts) - see README "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=adit.com
# Leave empty on a plain http://<LAN-IP> address (device sign-in with a code).
# Set to the dashboard's https address to use the normal Google redirect instead,
# e.g. https://spartan.adit.com (OAuth client type "Web application").
GOOGLE_PUBLIC_URL=

# Fallback only - used when GOOGLE_CLIENT_ID is empty: one shared team password.
DASHBOARD_PASSWORD=

# 0.0.0.0 = reachable by the team on the LAN; 127.0.0.1 = this PC only.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765

# Jenkins (for "Reminder UI", e.g. http://172.16.3.84:8080). API token: Jenkins > your name >
# Security > API Token > Add new token.
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Optional - auto-detected when empty (PATH, then IntelliJ's bundled Maven /
# ~/.jdks JDK 21).
MAVEN_CMD=
JAVA_HOME=
